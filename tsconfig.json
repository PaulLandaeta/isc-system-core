{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "module": "commonjs",
    "target": "ES2020",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "@migrations/*": ["data/migrations/*"]
    },
    "typeRoots": ["./src/@types", "./node_modules/@types"],
    "types": ["express", "jest"]
  },
  "include": ["src/**/*.ts"],
  "ts-node": { "files": true }
}
